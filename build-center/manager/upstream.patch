@@ -0,0 +1,107 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package com.sukisu.ultra.ui.component
+
+import androidx.compose.foundation.layout.*
+import androidx.compose.foundation.rememberScrollState
+import androidx.compose.foundation.verticalScroll
+import androidx.compose.material3.*
+import androidx.compose.runtime.*
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.res.stringResource
+import androidx.compose.ui.unit.dp
+import com.sukisu.ultra.R
+import com.sukisu.ultra.data.repository.*
+import com.topjohnwu.superuser.Shell
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+
+@Composable
+fun SusfsRuntimeCard(onOpenModules: () -> Unit) {
+    var open by remember { mutableStateOf(false) }
+    var snapshot by remember { mutableStateOf<RuntimeSnapshot?>(null) }
+    var busy by remember { mutableStateOf(false) }
+    var error by remember { mutableStateOf<String?>(null) }
+    var firmware by remember { mutableStateOf("") }
+    val scope = rememberCoroutineScope()
+    val repository = remember {
+        SusfsRuntimeRepository { command ->
+            val result = Shell.cmd(command).exec()
+            RuntimeCommandResult(result.code, result.out.joinToString("\n"), result.err.joinToString("\n"))
+        }
+    }
+    fun refresh() {
+        if (busy) return
+        busy = true
+        scope.launch {
+            try {
+                val result = withContext(Dispatchers.IO) {
+                    val property = ProcessBuilder("/system/bin/getprop", "ro.build.PDA").start()
+                        .inputStream.bufferedReader().use { it.readText().trim() }
+                    property to repository.read()
+                }
+                firmware = result.first
+                snapshot = result.second
+                error = null
+            } catch (failure: Exception) {
+                if (failure is CancellationException) throw failure
+                snapshot = null
+                error = failure.message ?: "Runtime nicht verfuegbar"
+            } finally { busy = false }
+        }
+    }
+    OutlinedCard(onClick = { open = true }, modifier = Modifier.fillMaxWidth()) {
+        Column(Modifier.padding(18.dp), verticalArrangement = Arrangement.spacedBy(5.dp)) {
+            Text(stringResource(R.string.kaos_runtime_title), style = MaterialTheme.typography.titleMedium)
+            Text(stringResource(R.string.kaos_runtime_summary), style = MaterialTheme.typography.bodyMedium)
+        }
+    }
+    LaunchedEffect(open) { if (open) refresh() }
+    if (open) AlertDialog(
+        onDismissRequest = { if (!busy) open = false },
+        title = { Text(stringResource(R.string.kaos_runtime_title)) },
+        text = {
+            Column(Modifier.heightIn(max = 520.dp).verticalScroll(rememberScrollState()), verticalArrangement = Arrangement.spacedBy(10.dp)) {
+                Text(stringResource(R.string.kaos_runtime_target))
+                if (firmware.isNotBlank()) Text(stringResource(R.string.kaos_runtime_device, firmware))
+                Text(stringResource(R.string.kaos_runtime_scope), style = MaterialTheme.typography.bodySmall)
+                if (busy) LinearProgressIndicator(Modifier.fillMaxWidth())
+                error?.let { Text(it, color = MaterialTheme.colorScheme.error) }
+                RuntimeControl.entries.forEach { control ->
+                    val current = snapshot
+                    val label = when (control) {
+                        RuntimeControl.UidGate -> R.string.kaos_runtime_uid
+                        RuntimeControl.HiddenName -> R.string.kaos_runtime_names
+                        RuntimeControl.Unicode -> R.string.kaos_runtime_unicode
+                        RuntimeControl.Symbols -> R.string.kaos_runtime_symbols
+                    }
+                    Row(Modifier.fillMaxWidth(), verticalAlignment = Alignment.CenterVertically) {
+                        Text(stringResource(label), Modifier.weight(1f))
+                        Switch(checked = current?.enabled(control) == true,
+                            enabled = !busy && current?.supports(control) == true,
+                            onCheckedChange = { value ->
+                                if (current != null && !busy) {
+                                    busy = true
+                                    scope.launch {
+                                        try {
+                                            snapshot = withContext(Dispatchers.IO) { repository.set(control, value, current) }
+                                            error = null
+                                        } catch (failure: Exception) {
+                                            if (failure is CancellationException) throw failure
+                                            error = failure.message ?: "Aenderung nicht bestaetigt"
+                                            snapshot = withContext(Dispatchers.IO) { runCatching { repository.read() }.getOrNull() }
+                                        } finally { busy = false }
+                                    }
+                                }
+                            })
+                    }
+                }
+                OutlinedButton(onClick = { refresh() }, enabled = !busy) { Text(stringResource(R.string.kaos_runtime_refresh)) }
+                TextButton(onClick = { open = false; onOpenModules() }, enabled = !busy) { Text(stringResource(R.string.kaos_runtime_module)) }
+            }
+        },
+        confirmButton = { TextButton(onClick = { open = false }, enabled = !busy) { Text(stringResource(android.R.string.ok)) } }
+    )
+}
