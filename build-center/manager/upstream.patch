index 0000000..9a4d232
--- /dev/null
+++ b/manager/app/src/main/java/com/sukisu/ultra/data/repository/SusfsRuntimeRepository.kt
@@ -0,0 +1,66 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+package com.sukisu.ultra.data.repository
+
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonPrimitive
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.longOrNull
+
+enum class RuntimeControl(val argument: String, val bit: Long) {
+    UidGate("uid-gating", 1), HiddenName("hidden-name", 2),
+    Unicode("unicode-filter", 4), Symbols("symbol-hiding", 8)
+}
+
+data class RuntimeSnapshot(val supported: Long, val enabled: Long, val generation: Long) {
+    fun supports(control: RuntimeControl) = supported and control.bit != 0L
+    fun enabled(control: RuntimeControl) = enabled and control.bit != 0L
+
+    companion object {
+        fun parse(output: String): RuntimeSnapshot {
+            val obj = Json.parseToJsonElement(output).jsonObject
+            require((obj["protocol"] as? JsonPrimitive)?.content == "kaoslab-susfs-runtime") { "Unbekanntes Runtime-Protokoll" }
+            fun number(key: String): Long {
+                val value = obj[key] as? JsonPrimitive ?: error("Runtime-Feld fehlt: $key")
+                require(!value.isString) { "Runtime-Zahl erwartet: $key" }
+                return value.longOrNull ?: error("Ungueltige Runtime-Zahl: $key")
+            }
+            require(number("version") == 1L && number("size") == 48L) { "Runtime-ABI wird nicht unterstuetzt" }
+            val supported = number("supported")
+            val enabled = number("enabled")
+            val generation = number("generation")
+            require(supported in 0L..15L && enabled in 0L..15L && (enabled and supported.inv()) == 0L) { "Ungueltige Runtime-Maske" }
+            require(generation in 1..0xffffffffL) { "Ungueltige Runtime-Generation" }
+            return RuntimeSnapshot(supported, enabled, generation)
+        }
+    }
+}
+
+data class RuntimeCommandResult(val code: Int, val output: String, val error: String = "")
+fun interface RuntimeCommandRunner { fun run(command: String): RuntimeCommandResult }
+
+class SusfsRuntimeRepository(private val runner: RuntimeCommandRunner) {
+    companion object { const val TOOL = "/data/adb/modules/ReSuSFS/bin/susfs-runtime" }
+
+    private fun execute(command: String): RuntimeSnapshot {
+        val result = runner.run(command)
+        check(result.code == 0) {
+            (result.error.ifBlank { result.output }.ifBlank { "Runtime nicht verfuegbar (Root/ReSuSFS pruefen)" }).take(300)
+        }
+        return RuntimeSnapshot.parse(result.output.trim())
+    }
+
+    fun read() = execute("$TOOL status")
+
+    fun set(control: RuntimeControl, value: Boolean, observed: RuntimeSnapshot): RuntimeSnapshot {
+        require(observed.supports(control)) { "Diese Funktion wird vom laufenden Kernel nicht unterstuetzt" }
+        require(observed.generation in 1..0xffffffffL)
+        // The helper checks this observed generation atomically. Never retry a
+        // stale setter: refresh first so concurrent WebUI changes remain visible.
+        val result = execute("$TOOL set ${control.argument} ${if (value) 1 else 0} ${observed.generation}")
+        check(result.supported == observed.supported && result.enabled(control) == value &&
+              (result.enabled and control.bit.inv()) == (observed.enabled and control.bit.inv())) {
+            "Runtime-Aenderung nicht bestaetigt; Status neu laden"
+        }
+        return result
+    }
+}
