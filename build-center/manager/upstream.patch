+
+private fun checkEzj1ManagerRelease(): LatestVersionInfo = runCatching {
+    val url = "https://api.github.com/repos/kaos2310/Super-Builders/releases?per_page=40"
+    ksuApp.okhttpClient.newCall(Request.Builder().url(url).build()).execute().use { response ->
+        if (!response.isSuccessful) return LatestVersionInfo()
+        val releases = org.json.JSONArray(response.body.string())
+        val pattern = Regex("""^SukiSU_EZJ1_v.+_(\d+)-arm64-v8a-release\.apk$""")
+        var latest = LatestVersionInfo()
+        for (i in 0 until releases.length()) {
+            val release = releases.getJSONObject(i)
+            if (release.optBoolean("draft") || release.optBoolean("prerelease")) continue
+            val assets = release.getJSONArray("assets")
+            for (j in 0 until assets.length()) {
+                val asset = assets.getJSONObject(j)
+                val match = pattern.matchEntire(asset.optString("name")) ?: continue
+                val code = match.groupValues[1].toLongOrNull() ?: continue
+                val download = asset.optString("browser_download_url")
+                if (code > latest.versionCode && download.startsWith("https://github.com/kaos2310/Super-Builders/releases/download/")) {
+                    latest = LatestVersionInfo(code, download, release.optString("body"))
+                }
+            }
+        }
+        latest
+    }
+}.getOrDefault(LatestVersionInfo())
