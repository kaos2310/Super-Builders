+class SusfsRuntimeRepositoryTest {
+    private val status = """{"protocol":"kaoslab-susfs-runtime","version":1,"size":48,"supported":15,"enabled":15,"generation":7}"""
+
+    @Test fun readsAllFourCapabilitiesAndUnsignedGeneration() {
+        val value = RuntimeSnapshot.parse(status.replace("\"generation\":7", "\"generation\":4294967295"))
+        assertEquals(4294967295L, value.generation)
+        RuntimeControl.entries.forEach { assertTrue(value.supports(it)); assertTrue(value.enabled(it)) }
+    }
+
+    @Test fun malformedProtocolCannotEnableControls() {
+        val invalid = listOf(
+            status.replace("\"version\":1", "\"version\":2"),
+            status.replace("\"size\":48", "\"size\":44"),
+            status.replace("\"supported\":15", "\"supported\":16"),
+            status.replace("\"supported\":15", "\"supported\":13"),
+            status.replace("\"generation\":7", "\"generation\":0"),
+            status.replace("\"generation\":7", "\"generation\":4294967296"),
+            status.replace("\"generation\":7", "\"generation\":\"7\""),
+            status.replace("kaoslab-susfs-runtime", "unknown"))
+        invalid.forEach { data ->
+            assertThrows(Exception::class.java) { RuntimeSnapshot.parse(data) }
+        }
+    }
+
+    @Test fun setterUsesOneWhitelistedControlAndObservedGeneration() {
+        val commands = mutableListOf<String>()
+        val repository = SusfsRuntimeRepository { command ->
+            commands += command
+            RuntimeCommandResult(0, status.replace("\"enabled\":15", "\"enabled\":13").replace("\"generation\":7", "\"generation\":8"))
+        }
+        val after = repository.set(RuntimeControl.HiddenName, false, RuntimeSnapshot.parse(status))
+        assertEquals(listOf("/data/adb/modules/ReSuSFS/bin/susfs-runtime set hidden-name 0 7"), commands)
+        assertEquals(13L, after.enabled)
+    }
+
+    @Test fun staleSetterIsNeverRetried() {
+        var calls = 0
+        val repository = SusfsRuntimeRepository { calls++; RuntimeCommandResult(75, "unsupported feature or stale generation; no setter issued") }
+        assertThrows(IllegalStateException::class.java) { repository.set(RuntimeControl.HiddenName, false, RuntimeSnapshot.parse(status)) }
+        assertEquals(1, calls)
+    }
+
+    @Test fun unsupportedControlDoesNotIssueAnyCommand() {
+        var calls = 0
+        val repository = SusfsRuntimeRepository { calls++; RuntimeCommandResult(0, status) }
+        val observed = RuntimeSnapshot(13, 13, 7)
+        assertThrows(IllegalArgumentException::class.java) { repository.set(RuntimeControl.HiddenName, true, observed) }
+        assertEquals(0, calls)
+    }
+
+    @Test fun unintendedChangesToOtherBitsAreRejected() {
+        val repository = SusfsRuntimeRepository { RuntimeCommandResult(0, status.replace("\"enabled\":15", "\"enabled\":9")) }
+        assertThrows(IllegalStateException::class.java) { repository.set(RuntimeControl.HiddenName, false, RuntimeSnapshot.parse(status)) }
+    }
+}
