#!/system/bin/sh
# Integrated BRENE 0.0.76 adapter. No standalone BRENE boot scripts are sourced.
BINDIR=${ZM71_BINDIR:-${0%/*}}
NATIVE=${ZM71_NATIVE:-$BINDIR/arm64-v8a/zm-native-core}
CONFIG_READER=${ZM71_NATIVE:-$BINDIR/arm64-v8a/zeromount}
RP=${ZM71_RESETPROP:-$BINDIR/arm64-v8a/resetprop-rs}
KSUD=${ZM71_KSUD:-/data/adb/ksud}
[ -x "$KSUD" ] || KSUD=/data/adb/ksu/bin/ksud
STATE=${ZM76_STATE:-${ZM75_STATE:-${ZM71_STATE:-/data/adb/zeromount/brene71}}}
OWNER=${ZM76_OWNER:-$BINDIR/zm-susfs-owner}
SUSFS_TOOL=${ZM76_SUSFS_TOOL:-$BINDIR/ksu_susfs}
FILTER=$STATE/sus-path-uid-filter
KEYS="shrink_buffer_size spoof_hosts spoof_libstagefright hide_lineage_strings disable_child_process_restrictions hide_ksu_directories hide_third_party_apps hide_all_apps_with_uid_10000_and_above sus_path_uid_filter hide_vector_injection hide_oem_unlocking_toggle sanitize_build_fingerprint"
CONFIG=$STATE/options
key_valid() {
    case "$1" in shrink_buffer_size|spoof_hosts|spoof_libstagefright|hide_lineage_strings|disable_child_process_restrictions|hide_ksu_directories|hide_third_party_apps|hide_all_apps_with_uid_10000_and_above|sus_path_uid_filter|hide_vector_injection|hide_oem_unlocking_toggle|sanitize_build_fingerprint) return 0;; *) return 1;; esac
}
get_option() {
    key_valid "$1" || return 64
    local value
    value=$(sed -n "s/^$1=//p" "$CONFIG" 2>/dev/null)
    case "$value" in true|false) printf '%s\n' "$value";; '')
        if [ "$1" = shrink_buffer_size ]; then echo true; else echo false; fi;; *) return 65;; esac
}
write_options() {
    # Retain unknown/future keys and comments as inert data; never source config.
    if [ -f "$CONFIG" ]; then
        awk -F= '$1 !~ /^(shrink_buffer_size|spoof_hosts|spoof_libstagefright|hide_lineage_strings|disable_child_process_restrictions|hide_ksu_directories|hide_third_party_apps|hide_all_apps_with_uid_10000_and_above|sus_path_uid_filter|hide_vector_injection|hide_oem_unlocking_toggle|sanitize_build_fingerprint)$/ {print}' "$CONFIG" || return 65
    fi
    local key value
    for key in $KEYS; do
        if [ "$key" = "$1" ]; then value=$2; else value=$(get_option "$key") || return 65; fi
        printf '%s=%s\n' "$key" "$value" || return 1
    done
}
set_option() {
    key_valid "$1" || return 64
    case "$2" in true|false) ;; *) return 64;; esac
    umask 077
    mkdir -p "$STATE" || return 1
    mkdir "$STATE/config.lock" 2>/dev/null || return 75
    local tmp rc=0
    tmp=$STATE/options.tmp.$$
    write_options "$1" "$2" > "$tmp" && chmod 0600 "$tmp" && mv -f "$tmp" "$CONFIG" || rc=$?
    rm -f "$tmp"; rmdir "$STATE/config.lock"
    return "$rc"
}
normalize_filter() {
    [ "${#1}" -le 65534 ] || return 64
    # Nonempty comma sentinel clears the kernel bitmap. Package names are data.
    printf '%s' "$1" | LC_ALL=C awk -F, '
        NR>1 {exit 64}
        { for (i=1;i<=NF;i++) {
            name=$i; gsub(/^[ \t]+|[ \t]+$/, "", name)
            if (name=="") continue
            if (name=="." || name==".." || length(name)>255 || name !~ /^[A-Za-z0-9_.]+$/) exit 64
            if (!seen[name]++) { result=result (result ? "," : "") name }
        } }
        END { if (!result) result=","; print result }'
}
get_filter() {
    local value
    if [ -f "$FILTER" ]; then value=$(cat "$FILTER") || return 65; else value=,; fi
    normalize_filter "$value"
}
set_filter() {
    local value tmp rc=0
    value=$(normalize_filter "$1") || return 64
    umask 077
    mkdir -p "$STATE" || return 1
    mkdir "$STATE/config.lock" 2>/dev/null || return 75
    tmp=$STATE/filter.tmp.$$
    printf '%s\n' "$value" > "$tmp" && chmod 0600 "$tmp" && mv -f "$tmp" "$FILTER" || rc=$?
    rm -f "$tmp"; rmdir "$STATE/config.lock"
    return "$rc"
}
require_owners() {
    "$OWNER" allowed brene && "$OWNER" allowed susfs || {
        echo 'BRENE76: masters paused or external SUSFS owner active' >&2; return 65;
    }
}
apply_path_filter() {
    local value
    require_owners || return $?
    require_feature CONFIG_KSU_SUSFS_SUS_PATH || return 65
    [ -x "$SUSFS_TOOL" ] || { echo 'BRENE76: matching private SuSFS tool missing' >&2; return 65; }
    value=$(get_filter) || return 65
    "$SUSFS_TOOL" set_sus_path_uid_filter "$value"
}

native_enabled() { [ "$("$CONFIG_READER" config get "brene.$1" 2>/dev/null)" = true ]; }
boot_complete() { [ "$(getprop sys.boot_completed 2>/dev/null)" = 1 ]; }
patch_month() {
    # Decimal conversion avoids shell octal parsing of August/September.
    local year month day extra
    read -r year month day extra <<EOF
$(date '+%Y %m %d')
EOF
    case "$year:$month:$day:$extra" in ????:??:??:) ;; *) return 65;; esac
    case "$year$month$day" in *[!0-9]*) return 65;; esac
    month=${month#0}; day=${day#0}
    [ "$year" -ge 2024 ] && [ "$year" -le 2100 ] && [ "$month" -ge 1 ] && [ "$month" -le 12 ] && [ "$day" -ge 1 ] && [ "$day" -le 31 ] || return 65
    if [ "$day" -lt 5 ]; then
        month=$((month - 1))
        if [ "$month" -eq 0 ]; then month=12; year=$((year - 1)); fi
    fi
    printf '%04d-%02d\n' "$year" "$month"
}
existing_prop() {
    local old
    old=$("$RP" "$1") || return 1
    [ -z "$old" ] || [ "$old" = "$2" ] || "$RP" -n "$1" "$2"
}
property_pass() {
    # Defer the whole inherited writer until vold/init completed. This prevents
    # the native GENERAL table from setting ro.crypto.state prematurely.
    boot_complete || return 0
    # Give both inherited date options the same clock source. Reject an invalid
    # clock before the native writer can use its older current-month policy.
    local month=''
    if native_enabled spoof_os_security_patch_level_property || native_enabled spoof_vendor_security_patch_level_property; then
        month=$(patch_month) || { echo 'BRENE76: invalid clock; property pass skipped' >&2; return 65; }
    fi
    # The public zeromount alias re-enters this adapter for prop-watch.
    ZM76_PROP_WATCH_ACTIVE=1 "$NATIVE" prop-watch || return $?
    # Match native ownership and group opt-outs. An external SUSFS module owns
    # its own properties; this adapter must not follow a deferred native writer.
    local external
    external=$(cat "${ZM71_EXTERNAL_FLAG:-/data/adb/zeromount/flags/external_susfs}" 2>/dev/null)
    case "$external" in ''|none) ;; *) return 0;; esac
    native_enabled prop_spoofing || return 0
    native_enabled spoof_os_security_patch_level_property && existing_prop ro.build.version.security_patch "$month-01"
    native_enabled spoof_vendor_security_patch_level_property && existing_prop ro.vendor.build.security_patch "$month-05"
    # Native property handling is complete before this late correction.
    existing_prop ro.crypto.state encrypted
}
require_open_redirect() {
    local version features
    version=$("$KSUD" susfs version 2>/dev/null) || return 65
    [ "$version" = v2.4.0 ] || return 65
    features=$("$KSUD" susfs features 2>/dev/null) || return 65
    printf '%s\n' "$features" | tr ',\r' '\n\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | grep -qxF CONFIG_KSU_SUSFS_OPEN_REDIRECT
}
redirect_file() {
    local target=$1 replacement=$2
    [ -f "$target" ] && [ -f "$replacement" ] || return 66
    # Existing persistent user redirects keep ownership of their target.
    if grep -Fq "$target|" "${ZM71_RULES:-/data/adb/zeromount/open_redirect.conf}" 2>/dev/null; then
        echo "BRENE76: target already owned by persistent OPEN_REDIRECT rules: $target" >&2
        return 65
    fi
    # Keep per-path files distinct: same basenames across partitions must not
    # alias each other. Preserve the target's ownership, mode and SELinux label.
    chmod "$(stat -c %a "$target")" "$replacement" || return 1
    chown "$(stat -c %u:%g "$target")" "$replacement" || return 1
    chcon --reference="$target" "$replacement" || return 1
    "$KSUD" susfs add-open-redirect "$target" "$replacement" 3
}
apply_redirects() {
    local hosts lib lineage
    hosts=$(get_option spoof_hosts) || return $?
    lib=$(get_option spoof_libstagefright) || return $?
    lineage=$(get_option hide_lineage_strings) || return $?
    [ "$hosts:$lib:$lineage" = false:false:false ] && return 0
    require_open_redirect || { echo 'BRENE76: exact SUSFS OPEN_REDIRECT unavailable' >&2; return 65; }
    local bid ledger intent
    bid=$(cat /proc/sys/kernel/random/boot_id) || return 1
    ledger=$STATE/redirects.applied
    intent=$STATE/redirects.intent
    if [ -f "$ledger" ]; then
        [ "$(cat "$ledger")" = "$bid" ] && return 0
    fi
    if [ -f "$intent" ] && [ "$(cat "$intent")" = "$bid" ]; then
        echo 'BRENE76: redirect state uncertain; reboot before another attempt' >&2
        return 75
    fi
    mkdir -p "$STATE/fake-files" || return 1
    printf '%s\n' "$bid" > "$intent" || return 1
    if [ "$hosts" = true ]; then
        printf '127.0.0.1       localhost\n::1             ip6-localhost\n\n' > "$STATE/fake-files/hosts" || return 1
        redirect_file /system/etc/hosts "$STATE/fake-files/hosts" || return $?
    fi
    if [ "$lib" = true ]; then
        : > "$STATE/fake-files/libstagefright.so"
        redirect_file /system/lib64/libstagefright.so "$STATE/fake-files/libstagefright.so" || return $?
    fi
    if [ "$lineage" = true ]; then
        # Opt-in stock-ROM adaptation, equivalent to BRENE76's empty views for
        # unmounted app UIDs. Paths are read literally; no shell evaluation.
        find /system /system_ext /vendor /product -type f \( -iname '*sepolicy.cil' -o -iname '*file_contexts' -o -iname '*.rc' \) > "$STATE/lineage-paths" || return 1
        local path file
        while IFS= read -r path; do
            case "$path" in *.rc) grep -iq lineage "$path" || continue;; esac
            file=$(printf '%s' "$path" | sha256sum); file=${file%% *}
            : > "$STATE/fake-files/$file"
            redirect_file "$path" "$STATE/fake-files/$file" || return $?
        done < "$STATE/lineage-paths"
        if [ -f /system_ext/etc/permissions/Updater.xml ]; then
            : > "$STATE/fake-files/updater"
            redirect_file /system_ext/etc/permissions/Updater.xml "$STATE/fake-files/updater" || return $?
        fi
    fi
    printf '%s\n' "$bid" > "$ledger"
}
require_feature() {
    local version features
    version=$("$KSUD" susfs version 2>/dev/null) || return 65
    [ "$version" = v2.4.0 ] || return 65
    features=$("$KSUD" susfs features 2>/dev/null) || return 65
    printf '%s\n' "$features" | tr ',\r' '\n\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | grep -qxF "$1"
}
apply_brene75() {
    local external key
    external=$(cat "${ZM71_EXTERNAL_FLAG:-/data/adb/zeromount/flags/external_susfs}" 2>/dev/null)
    case "$external" in ''|none) ;; *)
        for key in hide_ksu_directories hide_third_party_apps hide_all_apps_with_uid_10000_and_above sus_path_uid_filter hide_vector_injection; do
            if [ "$(get_option "$key")" = true ]; then
                echo 'BRENE76: another SUSFS module owns configuration; no competing rules applied' >&2; return 65
            fi
        done
        return 0;;
    esac
    if [ "$(get_option hide_ksu_directories)" = true ]; then
        require_feature CONFIG_KSU_SUSFS_SUS_PATH || return 65
        local root package kind path
        root=${ZM75_STORAGE_ROOT:-/storage/emulated/0/Android}
        for package in me.weishu.kernelsu com.rifsxd.ksunext com.resukisu.resukisu com.sukisu.ultra com.sukisu.nova org.frknkrc44.hma_oss com.termux; do
            for kind in data media obb; do
                path=$root/$kind/$package
                [ -e "$path" ] || continue
                "$KSUD" susfs add-sus-path-loop "$path" || return $?
            done
        done
    fi
    if [ "$(get_option hide_third_party_apps)" = true ] && [ "$(get_option hide_all_apps_with_uid_10000_and_above)" = false ]; then
        require_feature CONFIG_KSU_SUSFS_PRIORITY_UID_FILTER || return 65
        local raw list names
        raw=$STATE/packages.raw.$$
        names=$STATE/packages.names.$$
        cmd package list packages -3 > "$raw" || { rm -f "$raw"; return 65; }
        # Treat command output strictly as package data. Never source or evaluate it.
        LC_ALL=C awk 'NF { if ($0 !~ /^package:[A-Za-z0-9_.]+$/ || length($0)>263) exit 1; print substr($0,9) }' "$raw" > "$names" || { rm -f "$raw" "$names"; return 65; }
        list=$(LC_ALL=C sort -u "$names" | tr '\n' ',' | sed 's/,$//')
        rm -f "$raw" "$names"
        [ "${#list}" -le 65534 ] || return 65
        [ -n "$list" ] || list=,
        "$KSUD" susfs set-priority-uid-filter "$list" || return $?
    fi
    if [ "$(get_option hide_all_apps_with_uid_10000_and_above)" = true ]; then
        require_owners || return $?
        require_feature CONFIG_KSU_SUSFS_PRIORITY_UID_FILTER || return 65
        local list
        list=$(LC_ALL=C awk '
          NF { if ($1 !~ /^[A-Za-z0-9_.]+$/ || length($1)>255 || $1=="." || $1==".." || $2 !~ /^[0-9]+$/) exit 65;
               if ($2>=10000 && !seen[$1]++) result=result (result ? "," : "") $1 }
          END { if (!result) result=","; print result }
        ' "${ZM76_PACKAGES_LIST:-/data/system/packages.list}") || return 65
        [ "${#list}" -le 65534 ] || return 65
        "$KSUD" susfs set-priority-uid-filter "$list" || return $?
    fi
    if [ "$(get_option hide_vector_injection)" = true ]; then
        require_feature CONFIG_KSU_SUSFS_SUS_MAP || return 65
        local path
        for path in "${ZM76_MODULES_ROOT:-/data/adb/modules}"/zygisk_vector/zygisk/arm64-v8a.so "${ZM76_MODULES_ROOT:-/data/adb/modules}"/zygisk_vector/zygisk/armeabi-v7a.so; do
            [ -f "$path" ] || continue
            "$KSUD" susfs add-sus-map "$path" || return $?
        done
    fi
    if [ "$(get_option sus_path_uid_filter)" = true ]; then
        apply_path_filter || return $?
    fi

}

late_properties() {
    # Keep the existing properties group opt-out. New transformations are opt-in.
    local external
    external=$(cat "${ZM71_EXTERNAL_FLAG:-/data/adb/zeromount/flags/external_susfs}" 2>/dev/null)
    case "$external" in ''|none) ;; *) return 0;; esac
    native_enabled prop_spoofing || return 0
    if [ "$(get_option hide_oem_unlocking_toggle)" = true ]; then
        existing_prop ro.oem_unlock_supported 0 || return $?
    fi
    if [ "$(get_option sanitize_build_fingerprint)" = true ]; then
        local old value
        old=$("$RP" ro.build.fingerprint) || return $?
        [ -n "$old" ] || return 0
        value=$(printf '%s' "$old" | sed -e 's/userdebug/user/g' -e 's/test-keys/release-keys/g' -e 's/eng//g' -e 's/crdroid//g' -e 's/lineage//g' -e 's/evolution//g') || return 65
        [ -n "$value" ] || return 65
        [ "$old" = "$value" ] || "$RP" -n ro.build.fingerprint "$value"
    fi
}

late_features() {
    boot_complete || { echo 'BRENE76: boot not completed' >&2; return 75; }
    require_owners || return $?
    local key
    for key in $KEYS; do get_option "$key" >/dev/null || return 65; done
    get_filter >/dev/null || return 65
    umask 077
    mkdir -p "$STATE" || return 1
    mkdir "$STATE/apply.lock" 2>/dev/null || return 75
    trap 'rmdir "$STATE/apply.lock"' EXIT
    if [ "$(get_option shrink_buffer_size)" = true ]; then
        logcat -G 64K || return $?
        "$RP" -n -p persist.logd.size 65536 || return $?
    fi
    if [ "$(get_option disable_child_process_restrictions)" = true ]; then
        "$RP" -n persist.sys.fflag.override.settings_enable_monitor_phantom_procs false || return $?
    fi
    apply_redirects || return $?
    apply_brene75 || return $?
    late_properties
}
status() {
    # Status performs no writes and uses a fixed schema without shell-sourced data.
    local key value filter sep=''
    filter=$(get_filter) || return 65
    printf '{"version":"0.0.76","settings":{"values":{'
    for key in $KEYS; do
        value=$(get_option "$key") || return $?
        printf '%s"%s":"%s"' "$sep" "$key" "$value"; sep=,
    done
    printf '}},"sus_path_uid_filter_packages":"%s","application":"next_boot","device_tested":false}\n' "$filter"
}
case "${1:-status}" in
    status) [ "$#" -le 1 ] || exit 64; status;;
    filter-get) [ "$#" -eq 1 ] || exit 64; get_filter;;
    filter-set) [ "$#" -eq 2 ] || exit 64; set_filter "$2";;
    get) [ "$#" -eq 2 ] || exit 64; get_option "$2";;
    set) [ "$#" -eq 3 ] || exit 64; set_option "$2" "$3";;
    patch-month) [ "$#" -eq 1 ] || exit 64; patch_month;;
    prop-watch)
        if [ "${ZM76_PROP_WATCH_ACTIVE:-}" = 1 ]; then
            echo 'BRENE76: recursive prop-watch dispatch refused' >&2
            exit 65
        fi
        case "$#:${2:-}" in 1:) property_pass;; 2:--repeat) while :; do property_pass || exit $?; sleep 60; done;; *) exit 64;; esac;;
    late) [ "$#" -eq 1 ] || exit 64; late_features;;
    *) echo 'usage: zm brene76 status|get KEY|set KEY true|false|late' >&2; exit 64;;
esac
